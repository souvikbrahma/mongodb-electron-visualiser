{
  "name": "mongo-visualiser",
  "version": "1.0.0",
  "description": "A focused desktop MongoDB visualizer built with Electron.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:editor": "esbuild src/renderer/query-editors.js --bundle --minify --outfile=src/renderer/query-editors.bundle.js",
    "prestart": "npm run build:editor",
    "predev": "npm run build:editor"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "mongodb": "^6.18.0"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "esbuild": "^0.28.2"
  }
}
